{
  "name": "server",
  "version": "0.4.0",
  "description": "domino game for 2-4 players (humans and bots) running on websocket API",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "nest start --watch",
    "start:prod": "node dist/index.js",
    "build": "nest build"
  },
  "keywords": [
    "domino",
    "game"
  ],
  "author": "Andrew1407, dgomilko",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-fastify": "^12.5.0",
    "@nestjs/platform-ws": "^12.5.0",
    "@nestjs/websockets": "^12.5.0",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@swc/core": false
  }
