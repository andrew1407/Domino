# default game server (can be changed at runtime in the "Server" settings)
NEXT_PUBLIC_SERVER_ADDR = localhost:8080
NEXT_PUBLIC_WS_ADDR = localhost:8081
# "online" (server API) or "offline" (in-browser game with bots)
NEXT_PUBLIC_DEFAULT_MODE = online
# base path for static hosting (e.g. /Domino for GitHub Pages)
NEXT_PUBLIC_BASE_PATH =
